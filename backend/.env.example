# .env.example
#
# Copy this file and rename it to ".env"
# Fill in your own values.
# NEVER commit the real .env file to Git.

# MongoDB connection string
# Free cloud database: https://www.mongodb.com/atlas
# Local MongoDB:       mongodb://localhost:27017/nexvoice
MONGO_URI=mongodb://localhost:27017/nexvoice

# Port the server listens on
PORT=5000

# ── Phase 4B-2: LiveKit voice (SFU) ──────────────────────────────────────
# Local dev server: run `livekit-server --dev --bind 0.0.0.0`
# (or via Docker, see backend README Phase 4B-2 section).
# Dev credentials printed by --dev are: key "devkey", secret "secret".
#
# IMPORTANT: LIVEKIT_URL is handed to Android clients, so it must be
# reachable FROM the device, not from this PC:
#   - Android Emulator → ws://10.0.2.2:7880
#   - Physical phone (same WiFi) → ws://<PC-LAN-IP>:7880  (e.g. ws://192.168.1.15:7880)
# For LiveKit Cloud, use wss://<your-project>.livekit.cloud with its key/secret.
LIVEKIT_URL=ws://10.0.2.2:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
