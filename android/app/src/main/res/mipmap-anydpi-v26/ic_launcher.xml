<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher.xml (mipmap adaptive icon)
    This is the adaptive icon format (Android 8.0+).
    It uses a separate background + foreground layer so the OS can
    clip it into different shapes (circle, squircle, etc.) per manufacturer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
