<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nex_bg">#0A0A0F</color>
    <color name="nex_gold">#FFB020</color>
    <color name="nex_surface">#13131A</color>
    <string name="app_name">NexVoice</string>
    <style name="Theme.NexVoice" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nex_bg</item>
        <item name="android:statusBarColor">@color/nex_bg</item>
        <item name="android:navigationBarColor">@color/nex_bg</item>
    </style>
    <style name="Theme.NexVoice.SplashScreen" parent="Theme.SplashScreen">
        
        <item name="windowSplashScreenBackground">@color/nex_bg</item>
        
        <item name="postSplashScreenTheme">@style/Theme.NexVoice</item>
    </style>
</resources>